# Browser -> backend (public: it is embedded in the JS bundle at BUILD time; redeploy after changing it)
#   local:   http://localhost:3001/api/v1
#   Vercel:  https://<your-backend>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Next.js server (SSR of /reportes) -> backend. Same value on Vercel; inside Docker Compose use http://backend:3001/api/v1
API_URL=http://localhost:3001/api/v1
# Optional. Only if the backend defines API_KEY. WARNING: NEXT_PUBLIC_* is visible to anyone who opens the site;
# use it only for demos. For real access control enable accounts in the backend (JWT_SECRET) and use /ingresar.
NEXT_PUBLIC_API_KEY=
