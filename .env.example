# Browser -> backend (public: it is embedded in the JS bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Next.js server (SSR of /reportes) -> backend. Inside Docker Compose use http://backend:3001/api/v1
API_URL=http://localhost:3001/api/v1
# Optional. Only if the backend defines API_KEY. WARNING: NEXT_PUBLIC_* is visible to anyone who opens the site;
# use it only for demos/trusted networks. For real auth put the backend behind a login (see AI_CONTEXT.md).
NEXT_PUBLIC_API_KEY=
